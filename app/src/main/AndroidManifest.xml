<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.lksnext.parkingJReboiro">

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <application
        android:allowBackup="true"
        android:icon="@drawable/lks_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/lks_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.ParkingLKS">
        <activity
            android:name="com.lksnext.parkingJReboiro.view.activity.RegisterActivity"
            android:exported="false" />
        <activity
            android:name="com.lksnext.parkingJReboiro.view.activity.LoginActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name="com.lksnext.parkingJReboiro.view.activity.MainActivity"
            android:exported="true" />
        <activity android:name="com.lksnext.parkingJReboiro.view.activity.RecuperarPasswordActivity" />
        <activity android:name=".view.activity.CompleteProfileActivity" />
        <receiver android:name=".notifications.ReservaNotificationReceiver"/>
    </application>

</manifest>